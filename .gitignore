# ============================
# CIVITRACK - Root .gitignore
# ============================

# Node modules (both client and server)
node_modules/
client/node_modules/
server/node_modules/

# Build output
client/dist/
client/dist-ssr/

# Environment variables — NEVER commit secrets
server/.env
.env
.env.local
.env.*.local

# Uploaded user files (runtime only, not source code)
server/uploads/*.jpg
server/uploads/*.jpeg
server/uploads/*.png
server/uploads/*.webp
server/uploads/*.gif
# Keep the uploads folder itself (for git)
!server/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# Vite / Build cache
*.local
.cache/
